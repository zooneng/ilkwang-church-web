# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# church runtime data and private local records (keep member PII and 75MB+ media out of git)
/data/*.json
/data/*.tmp
/public/legacy-gallery/
/public/uploads/*
!/public/uploads/resources/
/public/uploads/resources/*
!/public/uploads/resources/heidelberg-catechism-original.pdf
/docs/*.private.md
