# 1. 사이트 전체 관리자 비밀번호 (로그인 탭: 사이트 관리자 모드 -> /admin 전체 이용)
ADMIN_PASSWORD=

# 2. 사진 업로드 전용 비밀번호 (로그인 탭: 사진 업로드 전용 -> /admin/photos 앨범 업로드만 허용)
PHOTO_ADMIN_PASSWORD=

# 3. 세션 쿠키 서명용 시크릿 (비워 두면 비밀번호 기반 HMAC 파생키 자동 사용)
ADMIN_SESSION_SECRET=

# 4. Supabase 운영 데이터베이스 및 파일 저장소 연동 (비워 두면 로컬 data/*.json 자동 사용)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 아래 두 방식 중 하나만 설정하면 됩니다:
# (방식 A) 서버 전용 Auth 계정 비밀번호 + 이메일 (기본값: server-admin@ilkwang.internal)
SUPABASE_SERVER_SECRET=
SUPABASE_SERVER_EMAIL=
# (방식 B) 또는 Supabase service_role 시크릿 키 직접 사용 (서버 전용, 절대 NEXT_PUBLIC_ 금지)
SUPABASE_SERVICE_ROLE_KEY=
